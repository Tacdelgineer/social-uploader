# Cloudflare deployment (used by Wrangler/CI, not exposed to the browser)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Required now: R2 S3 credentials used only by the Worker to sign temporary,
# exact-size direct uploads. Scope the token to the social-uploader bucket only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Required in a later OAuth milestone (not used by Milestone 1).
# Google Cloud OAuth 2.0 Web application with YouTube Data API v3 enabled.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Meta app with Facebook Login for Business and Instagram Graph API access.
META_APP_ID=
META_APP_SECRET=

# TikTok developer app with Login Kit and Content Posting API access.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Future server-side security values. Generate independent random 32+ byte values.
OAUTH_ENCRYPTION_KEY=
SESSION_SECRET=
LOCAL_WORKER_SHARED_SECRET=

# Canonical deployed origin used for future OAuth callbacks, for example:
# https://social-uploader.<your-subdomain>.workers.dev
APP_BASE_URL=
