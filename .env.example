# Cloudflare deployment (used by Wrangler/CI, never exposed to the browser)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Required: R2 S3 credentials used only by the Worker to sign temporary,
# exact-size direct uploads. Scope the token to the social-uploader bucket only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Required in Milestone 2: Google Cloud OAuth 2.0 Web application with the
# YouTube Data API v3 enabled. Store both as encrypted Worker secrets.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Required in Milestone 2. Generate independent cryptographically random values.
# OAUTH_ENCRYPTION_KEY must be base64 for exactly 32 random bytes.
# SESSION_SECRET must contain at least 32 random characters.
OAUTH_ENCRYPTION_KEY=
SESSION_SECRET=

# Canonical deployed origin; Google redirects to APP_BASE_URL plus
# /api/oauth/youtube/callback.
APP_BASE_URL=https://social-uploader.example.workers.dev

# Required in Milestone 3: Meta Business app using Instagram API with Instagram Login.
# Store the Instagram App ID/secret as encrypted Worker secrets.
META_APP_ID=
META_APP_SECRET=

# Required in Milestone 3: TikTok Web app with Login Kit, Content Posting API,
# Direct Post, user.info.basic, and video.publish.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Future mini-PC worker authentication. Not used in Milestone 2.
LOCAL_WORKER_SHARED_SECRET=
